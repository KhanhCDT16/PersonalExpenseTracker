@model PersonalExpenseTracker.Models.Transactions.TransactionDetailsViewModel
@{ ViewData["Title"] = "Transaction details"; }
<div class="form-page">
    <p class="eyebrow">TRANSACTION DETAILS</p><h1>@Model.CategoryName</h1>
    <section class="panel delete-panel">
        <dl class="details-list">
            <div><dt>Date</dt><dd>@Model.Date.ToString("dd MMMM yyyy")</dd></div>
            <div><dt>Category</dt><dd><span class="inline-swatch" style="background:@Model.CategoryColor"></span>@Model.CategoryName</dd></div>
            <div><dt>Type</dt><dd>@Model.Type</dd></div>
            <div><dt>Amount</dt><dd>@Model.Amount.ToString("C")</dd></div>
            <div><dt>Description</dt><dd>@(Model.Description ?? "—")</dd></div>
            <div><dt>Last updated</dt><dd>@Model.UpdatedAtUtc.ToString("u")</dd></div>
        </dl>
        <div class="form-actions"><a class="button" asp-action="Edit" asp-route-id="@Model.Id">Edit</a><a class="danger-link" asp-action="Delete" asp-route-id="@Model.Id">Delete</a><a asp-action="Index">Back</a></div>
    </section>
</div>
