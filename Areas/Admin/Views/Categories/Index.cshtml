@model IReadOnlyList<PersonalExpenseTracker.Data.Entities.Category>
@{ ViewData["Title"] = "Admin · Categories"; }
<div class="section-heading page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Global categories</h1><p class="muted">Shared categories are visible to every active user.</p></div><div><a asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a> <a class="button" asp-action="Create">Add global category</a></div></div>
<section class="panel"><div class="category-grid">@foreach (var category in Model) { <article class="category-card"><span class="category-swatch" style="background:@category.ColorHex"></span><div><strong>@category.Name</strong><span>@category.Type · @(category.IsActive ? "Active" : "Inactive")</span></div><div class="category-actions"><a asp-action="Edit" asp-route-id="@category.Id">Edit</a><form asp-action="ToggleActive" asp-route-id="@category.Id" method="post"><button type="submit" class="link-button">@(category.IsActive ? "Deactivate" : "Activate")</button></form></div></article> }</div></section>
