@model PersonalExpenseTracker.Models.Transactions.TransactionFormViewModel
@{ ViewData["Title"] = "Add transaction"; }
<div class="form-page">
    <p class="eyebrow">NEW RECORD</p><h1>Add transaction</h1><p class="muted">Record income or an expense in your private ledger.</p>
    <form asp-action="Create" method="post" class="panel form-panel">
        <partial name="_TransactionForm" model="Model" />
        <div class="form-actions"><button class="button" type="submit">Save transaction</button><a asp-action="Index">Cancel</a></div>
    </form>
</div>
