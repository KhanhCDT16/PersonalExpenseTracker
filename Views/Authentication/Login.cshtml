@model PersonalExpenseTracker.Models.Authentication.LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-shell">
    <section class="auth-intro">
        <p class="eyebrow">WELCOME BACK</p>
        <h1>Take control of your money.</h1>
        <p>Review spending, protect your budget, and keep your goals moving.</p>
    </section>

    <form asp-action="Login" method="post" class="panel auth-card">
        <input asp-for="ReturnUrl" type="hidden" />
        <h2>Log in</h2>
        <p class="muted">Use the account you created for ExpenseTracker.</p>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" autofocus />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password"></span>
        </div>
        <label class="checkbox-row">
            <input asp-for="RememberMe" />
            <span>@Html.DisplayNameFor(model => model.RememberMe)</span>
        </label>
        <button class="button button-block" type="submit">Log in</button>
        <p class="auth-switch">New here? <a asp-action="Register">Create an account</a></p>
    </form>
</div>
