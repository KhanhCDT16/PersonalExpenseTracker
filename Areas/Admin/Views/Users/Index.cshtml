@model AdminUsersViewModel
@{ ViewData["Title"] = "Admin · Users"; }
<div class="section-heading page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Users</h1><p class="muted">@Model.TotalCount registered account@(Model.TotalCount == 1 ? "" : "s").</p></div><a asp-area="Admin" asp-controller="Categories" asp-action="Index">Manage global categories</a></div>
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert error" role="alert">@errorMessage</div> }
<form method="get" class="filter-bar"><div class="field filter-search"><label for="search">Search</label><input id="search" name="search" value="@Model.Search" placeholder="Email or display name" /></div><button class="button button-secondary" type="submit">Search</button><a asp-action="Index">Clear</a></form>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>User</th><th>Created</th><th>Status</th><th>Role</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody>@foreach (var user in Model.Users) { <tr><td><strong>@user.DisplayName</strong><br /><span class="muted">@user.Email</span></td><td>@user.CreatedAtUtc.ToString("yyyy-MM-dd")</td><td><span class="badge @(user.IsActive ? "income" : "expense")">@(user.IsActive ? "Active" : "Inactive")</span></td><td>@(user.IsAdmin ? "Admin" : "User")</td><td class="actions"><form asp-action="ToggleActive" asp-route-id="@user.Id" method="post"><button type="submit" class="link-button">@(user.IsActive ? "Deactivate" : "Activate")</button></form><form asp-action="ToggleAdmin" asp-route-id="@user.Id" method="post"><button type="submit" class="link-button">@(user.IsAdmin ? "Remove admin" : "Make admin")</button></form></td></tr> }</tbody></table></div></section>
