@model IReadOnlyList<PersonalExpenseTracker.Models.SavingGoals.SavingGoalListItemViewModel>
@{ ViewData["Title"] = "Saving goals"; }
<div class="section-heading page-heading"><div><p class="eyebrow">BUILD TOWARD SOMETHING</p><h1>Saving goals</h1><p class="muted">Track contributions without mixing them into the goal definition.</p></div><a class="button" asp-action="Create">Create goal</a></div>
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert error" role="alert">@errorMessage</div> }
@if (Model.Count == 0)
{
    <section class="panel empty-state"><h2>No active saving goals</h2><p>Create a goal and start recording contributions.</p></section>
}
else
{
    <div class="goal-grid">
    @foreach (var goal in Model)
    {
        <article class="panel goal-card">
            <div class="budget-heading"><div><span>@(goal.TargetDate.HasValue ? $"Target {goal.TargetDate:dd MMM yyyy}" : "No deadline")</span><h2>@goal.Name</h2></div><span class="badge income">@goal.Status</span></div>
            <div class="budget-values"><strong>@goal.SavedAmount.ToString("C")</strong><span>of @goal.TargetAmount.ToString("C")</span></div>
            <div class="progress-track"><span style="width:@Math.Min(100, goal.ProgressPercent).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
            <p>@goal.Remaining.ToString("C") remaining · @goal.ProgressPercent.ToString("0.#")%</p>
            <form asp-action="AddContribution" method="post" class="contribution-form">
                <input type="hidden" name="SavingGoalId" value="@goal.Id" /><input type="number" name="Amount" min="0.01" step="0.01" placeholder="Amount" required /><input type="date" name="Date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /><input type="text" name="Note" maxlength="250" placeholder="Optional note" /><button class="button button-small" type="submit">Add</button>
            </form>
            <div class="category-actions"><a asp-action="Edit" asp-route-id="@goal.Id">Edit</a><form asp-action="Archive" asp-route-id="@goal.Id" method="post" onsubmit="return confirm('Archive this goal?');"><button type="submit" class="link-button danger-link">Archive</button></form></div>
        </article>
    }
    </div>
}
