@model PersonalExpenseTracker.Models.Profile.ProfileViewModel
@{ ViewData["Title"] = "Profile"; }
<div class="form-page"><p class="eyebrow">ACCOUNT PREFERENCES</p><h1>Profile</h1><p class="muted">Your email is used for sign-in. Your selected currency controls how monetary values are displayed throughout the website.</p><form asp-action="Index" method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label>Email</label><input value="@Model.Email" disabled /></div><div class="field"><label asp-for="DisplayName"></label><input asp-for="DisplayName" /><span asp-validation-for="DisplayName"></span></div><div class="form-grid"><div class="field"><label asp-for="CurrencyCode"></label><select asp-for="CurrencyCode" asp-items="Model.Currencies"></select><span asp-validation-for="CurrencyCode"></span></div><div class="field"><label asp-for="TimeZoneId"></label><select asp-for="TimeZoneId" asp-items="Model.TimeZones"></select><span asp-validation-for="TimeZoneId"></span></div></div><div class="form-actions"><button class="button" type="submit">Save profile</button></div></form></div>
